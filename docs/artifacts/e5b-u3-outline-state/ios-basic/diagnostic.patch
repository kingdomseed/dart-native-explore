         for change in changes {
             colors[change.node] = change.color
         }
+        logDiagnostic("apply")
     }
 
     func removeNodes(_ ids: [UInt64]) {
         for id in ids { colors.removeValue(forKey: id) }
+        logDiagnostic("removeNodes")
     }
 
     func retainNodes(_ ids: Set<UInt64>) {
         colors = colors.filter { ids.contains($0.key) }
+        logDiagnostic("retainNodes")
     }
 
     func clearScene() {
         colors.removeAll()
+        logDiagnostic("clearScene")
+    }
+
+    private func logDiagnostic(_ operation: String) {
+        let entries = colors.keys.sorted().map { id in
+            let color = colors[id]!
+            return "\(id)=[\(color.r),\(color.g),\(color.b),\(color.a)]"
+        }.joined(separator: ";")
+        d3Log("U3HighlightState op=\(operation) count=\(colors.count) colors={\(entries)}")
     }
 }
