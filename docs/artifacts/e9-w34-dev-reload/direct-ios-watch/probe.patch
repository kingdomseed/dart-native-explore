+// ignore_for_file: implementation_imports
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:dart3d/src/doc_layer.dart';
+import 'package:dart3d/src/diff_apply.dart';
+import 'package:dart3d/src/scene_model.dart';
+import 'package:vector_math/vector_math.dart';
+
+void main(List<String> args) {
+  if (args.length != 2 ||
+      !['initial', 'material', 'environment', 'baseline'].contains(args[0]) ||
+      !RegExp(
+        r'^/private/tmp/dart3d-e9-reload-probe-20261027/r1/[^/]+\.fscene$',
+      ).hasMatch(args[1])) {
+    throw ArgumentError(
+      'Usage: w34_reload_source.dart initial|material|environment|baseline '
+      '/private/tmp/dart3d-e9-reload-probe-20261027/r1/<name>.fscene',
+    );
+  }
+  final file = File(args[1]);
+  final doc = args[0] == 'initial' || args[0] == 'baseline'
+      ? buildW34ReloadDocument()
+      : readFsceneLogged(file.readAsStringSync());
+  if (args[0] == 'material') {
+    doc.resources.values
+        .whereType<MaterialResource>()
+        .single
+        .properties['baseColor'] = const ColorValue(
+      0.03,
+      0.15,
+      0.7,
+      1,
+    );
+  }
+  if (args[0] == 'environment') {
+    doc.resources.values.whereType<EnvironmentResource>().single.exposure = 0.2;
+  }
+  final text = writeFsceneWithExtensions(doc);
+  readFsceneLogged(text);
+  file.writeAsStringSync(text, flush: true);
+  stdout.writeln(
+    'w34 host save=${args[0]} path=${file.path} '
+    'time=${DateTime.now().toUtc().toIso8601String()} strategy=in-place',
+  );
+}
+
+SceneDocument buildW34ReloadDocument() {
+  final doc = SceneDocument(
+    documentId: DocumentId(
+      Uint8List.fromList(List.generate(16, (i) => i + 34)),
+    ),
+    allocator: IdAllocator(session: 0x773334),
+  );
+  final material = doc.addResource(
+    MaterialResource(
+      doc.newId(),
+      name: 'w34.color',
+      type: 'physicallyBased',
+      properties: {
+        'baseColor': const ColorValue(0.7, 0.08, 0.03, 1),
+        'roughness': const DoubleValue(0.8),
+        'metallic': const DoubleValue(0),
+      },
+    ),
+  );
+  final geometry = doc.addResource(
+    GeometryResource(
+      doc.newId(),
+      procedural: CuboidGeometrySpec(extents: Vector3(1.8, 1.8, 1.8)),
+    ),
+  );
+  doc.createNode(
+    name: 'w34.cube',
+    transform: TrsTransform(
+      rotation: Quaternion.axisAngle(Vector3(0, 1, 0), 0.4),
+    ),
+    components: [
+      ComponentSpec(
+        'mesh',
+        properties: {
+          'geometry': ResourceRefValue(geometry.id),
+          'material': ResourceRefValue(material.id),
+        },
+      ),
+    ],
+    root: true,
+  );
+  doc.createNode(
+    name: 'w34.light',
+    components: [
+      ComponentSpec(
+        'directionalLight',
+        properties: {
+          'color': const ColorValue(1, 1, 1, 1),
+          'intensity': const DoubleValue(2),
+          'castsShadow': const BoolValue(false),
+        },
+      ),
+    ],
+    root: true,
+  );
+  doc.createNode(
+    name: 'w34.camera',
+    transform: TrsTransform(translation: Vector3(0, 0, -7)),
+    components: [
+      ComponentSpec(
+        'camera',
+        properties: {
+          'projection': const StringValue('perspective'),
+          'fovRadiansY': const DoubleValue(0.8),
+          'near': const DoubleValue(0.1),
+          'far': const DoubleValue(30),
+        },
+      ),
+    ],
+    root: true,
+  );
+  doc.stage.environmentRef = doc
+      .addResource(
+        EnvironmentResource(
+          doc.newId(),
+          name: 'w34.environment',
+          environment: const EmptyEnvironment(),
+          environmentIntensity: 0,
+          exposure: 1,
+          toneMapping: 'linear',
+          effects: EnvironmentEffectsSpec(),
+        ),
+      )
+      .id;
+  return doc;
+}
