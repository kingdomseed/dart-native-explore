+import 'dart:async';
+import 'dart:io';
+
+import 'package:dart3d/dart3d.dart';
+
+const kW34ReloadSource = String.fromEnvironment('DART3D_RELOAD_SOURCE');
+
+/// Disposable authored-file experiment. No transport or retry owns this path.
+final class W34ReloadProbe {
+  W34ReloadProbe({
+    required this.source,
+    required this.controller,
+    required this.log,
+    required this.onStatus,
+  });
+
+  final String source;
+  final SceneController controller;
+  final void Function(String) log;
+  final void Function(String) onStatus;
+  StreamSubscription<FileSystemEvent>? _watch;
+  SceneDocument? _document;
+
+  void start() {
+    log('w34 source=$source');
+    final file = File(source);
+    if (source.isEmpty || !file.isAbsolute || !source.endsWith('.fscene')) {
+      _error(
+        ArgumentError(
+          'DART3D_RELOAD_SOURCE must be an absolute .fscene path: $source',
+        ),
+      );
+      return;
+    }
+    try {
+      // Watching the parent retains observation across editor rename saves.
+      // Reads still target only the explicitly supplied authored file.
+      _watch = file.parent.watch().listen(
+        (event) {
+          if (event.path != source &&
+              !(event is FileSystemMoveEvent && event.destination == source)) {
+            return;
+          }
+          log('w34 watch type=${event.type} path=${event.path} event=$event');
+          _read(file);
+        },
+        onError: (Object error) => _error(error),
+        onDone: () {
+          log('w34 watch ended source=$source');
+          onStatus('File watch ended');
+        },
+      );
+      log('w34 watch subscribed source=$source');
+      _read(file);
+    } on FileSystemException catch (error) {
+      _error(error);
+    }
+  }
+
+  void _read(File file) {
+    SceneDocument next;
+    try {
+      final text = file.readAsStringSync();
+      log('w34 read source=$source characters=${text.length}');
+      next = readFsceneLogged(text, log: log);
+    } on FileSystemException catch (error) {
+      _error(error);
+      return;
+    } on FormatException catch (error) {
+      _error(error);
+      return;
+    } on FsceneFormatException catch (error) {
+      _error(error);
+      return;
+    } on FsceneVersionException catch (error) {
+      _error(error);
+      return;
+    } on FsceneUnsupportedFeatureException catch (error) {
+      _error(error);
+      return;
+    } on TypeError catch (error) {
+      // The JSON decoder casts authored fields; a wrong field type is input.
+      _error(error);
+      return;
+    } on ArgumentError catch (error) {
+      _error(error);
+      return;
+    }
+    final previous = _document;
+    final List<String> operations;
+    if (previous == null) {
+      controller.loadDocument(next);
+      operations = ['loadScene'];
+    } else {
+      operations = controller
+          .applyDiff(diffScene(previous, next), next)
+          .map((op) => op['op'] as String)
+          .toList();
+    }
+    _document = next;
+    log(
+      'w34 applied-request time=${DateTime.now().toUtc().toIso8601String()} '
+      'source=$source ops=$operations',
+    );
+    onStatus('Current file loaded');
+  }
+
+  void _error(Object error) {
+    log('w34 error source=$source $error');
+    onStatus('$error');
+  }
+
+  Future<void> dispose() async {
+    await _watch?.cancel();
+    _watch = null;
+  }
+}
