+// ignore_for_file: implementation_imports
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:dart3d/dart3d.dart';
+import 'package:dart3d/src/protocol.dart';
+import 'package:dart3d/src/scene_view.dart';
+import 'package:dart3d_example/w34_reload_probe.dart';
+import 'package:test/test.dart';
+
+import '../tool/w34_reload_source.dart' as host;
+
+class RecordingElement extends SceneViewElement {
+  RecordingElement(SceneController controller)
+    : super(SceneViewLeaf(controller: controller));
+  final sent = <({int tag, Uint8List bytes})>[];
+  @override
+  void sendMutation(int tag, Uint8List bytes) {
+    sent.add((tag: tag, bytes: Uint8List.fromList(bytes)));
+  }
+}
+
+void main() {
+  test(
+    'actual file events mutate controller incrementally, retain errors and recover',
+    () async {
+      final file = File(
+        '/private/tmp/dart3d-e9-reload-probe-20261027/r1/test-authored.fscene',
+      );
+      addTearDown(() {
+        if (file.existsSync()) file.deleteSync();
+      });
+      host.main(['initial', file.path]);
+      final controller = SceneController();
+      final element = RecordingElement(controller);
+      controller.attachElement(element);
+      addTearDown(controller.dispose);
+      final statuses = StreamController<String>.broadcast(sync: true);
+      addTearDown(statuses.close);
+      final logs = <String>[];
+      final probe = W34ReloadProbe(
+        source: file.path,
+        controller: controller,
+        log: (message) {
+          logs.add(message);
+          print(message);
+        },
+        onStatus: statuses.add,
+      );
+      addTearDown(probe.dispose);
+      probe.start();
+      expect(element.sent.map((m) => m.tag), [D3Protocol.loadScene]);
+      final original = writeFsceneWithExtensions(controller.document!);
+      final camera = controller.document!.nodes.values.singleWhere(
+        (n) => n.name == 'w34.camera',
+      );
+      final cameraTransform = encodeNodeCommandSpec(
+        camera,
+        controller.document!,
+      );
+
+      Future<void> save(void Function() edit) async {
+        element.sent.clear();
+        final loaded = statuses.stream.firstWhere(
+          (s) => s == 'Current file loaded',
+        );
+        edit();
+        await loaded.timeout(const Duration(seconds: 15));
+      }
+
+      List<String> operationNames() => element.sent.expand((m) {
+        expect(m.tag, D3Protocol.command);
+        final message =
+            jsonDecode(utf8.decode(m.bytes)) as Map<String, dynamic>;
+        return (message['ops'] as List).map((op) => op['op'] as String);
+      }).toList();
+
+      await save(() => host.main(['material', file.path]));
+      expect(operationNames(), ['upsertResource', 'updateNode']);
+      final blue =
+          controller.document!.resources.values
+                  .whereType<MaterialResource>()
+                  .single
+                  .properties['baseColor']
+              as ColorValue;
+      expect([blue.r, blue.g, blue.b], [0.03, 0.15, 0.7]);
+
+      await save(() => host.main(['environment', file.path]));
+      expect(operationNames(), ['upsertResource', 'updateStage']);
+      expect(
+        controller.document!.resources.values
+            .whereType<EnvironmentResource>()
+            .single
+            .exposure,
+        0.2,
+      );
+      final valid = controller.document;
+      element.sent.clear();
+      final error = statuses.stream.firstWhere(
+        (s) => s != 'Current file loaded',
+      );
+      file.writeAsStringSync('{', flush: true);
+      expect(
+        await error.timeout(const Duration(seconds: 15)),
+        contains('Exception'),
+      );
+      expect(controller.document, same(valid));
+      expect(element.sent, isEmpty);
+
+      await save(() => host.main(['baseline', file.path]));
+      expect(operationNames(), containsAll(['upsertResource', 'updateStage']));
+      expect(writeFsceneWithExtensions(controller.document!), original);
+      expect(
+        encodeNodeCommandSpec(
+          controller.document!.nodes[camera.id]!,
+          controller.document!,
+        ),
+        cameraTransform,
+      );
+      expect(logs.any((line) => line.startsWith('w34 watch type=')), isTrue);
+
+      await probe.dispose();
+      element.sent.clear();
+      host.main(['material', file.path]);
+      // Drain the real watch delivery interval after cancellation.
+      await Future<void>.delayed(const Duration(seconds: 1));
+      expect(element.sent, isEmpty);
+      expect(writeFsceneWithExtensions(controller.document!), original);
+    },
+  );
+
+  test(
+    'explicit source rejects absent, relative and unreadable inputs without loading',
+    () async {
+      for (final source in [
+        '',
+        'relative.fscene',
+        '/private/tmp/dart3d-e9-reload-probe-20261027/r1/missing/source.fscene',
+      ]) {
+        final controller = SceneController();
+        final statuses = <String>[];
+        final probe = W34ReloadProbe(
+          source: source,
+          controller: controller,
+          log: print,
+          onStatus: statuses.add,
+        );
+        probe.start();
+        expect(statuses, isNotEmpty);
+        expect(controller.document, isNull);
+        await probe.dispose();
+        controller.dispose();
+      }
+    },
+  );
+}
