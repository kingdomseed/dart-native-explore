diff --git a/dart3d/lib/dev_reload.dart b/dart3d/lib/dev_reload.dart
new file mode 100644
index 0000000..8b7ea68
--- /dev/null
+++ b/dart3d/lib/dev_reload.dart
@@ -0,0 +1,248 @@
+import 'dart:async';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'src/doc_layer.dart';
+import 'src/fsceneb_reader.dart';
+import 'src/scene_controller.dart';
+import 'src/scene_model.dart';
+
+/// One opt-in reload session. Construction opens no connection.
+final class DevSceneReload {
+  DevSceneReload({
+    required SceneController controller,
+    required Uri endpoint,
+    required void Function(String message) onStatus,
+  }) : _controller = controller,
+       _endpoint = endpoint,
+       _onStatus = onStatus {
+    if ((endpoint.scheme != 'ws' && endpoint.scheme != 'wss') ||
+        endpoint.host.isEmpty ||
+        endpoint.path != '/scene' ||
+        endpoint.hasQuery ||
+        endpoint.hasFragment ||
+        endpoint.userInfo.isNotEmpty) {
+      throw ArgumentError.value(
+        endpoint,
+        'endpoint',
+        'Expected ws(s)://host:port/scene',
+      );
+    }
+  }
+
+  final SceneController _controller;
+  final Uri _endpoint;
+  final void Function(String) _onStatus;
+  HttpClient? _client;
+  WebSocket? _socket;
+  StreamSubscription<void>? _messages;
+  Future<void>? _connecting;
+  Future<SceneDocument?>? _preparing;
+  Future<void>? _stopping;
+  bool _stopped = false;
+
+  /// Connects once. Completion acknowledges setup, not a rendered frame.
+  Future<void> start() {
+    if (_stopped || _connecting != null) {
+      throw StateError('Reload sessions are single-use');
+    }
+    _client = HttpClient();
+    return _connecting = _connect();
+  }
+
+  void _status(String message) {
+    if (!_stopped) _onStatus(message);
+  }
+
+  Future<void> _connect() async {
+    _status('connecting $_endpoint');
+    late final WebSocket socket;
+    try {
+      socket = await WebSocket.connect(
+        _endpoint.toString(),
+        customClient: _client,
+      );
+    } on IOException catch (error) {
+      if (!_stopped) {
+        _status('connection error $error; restart required');
+        _stopped = true;
+        _client!.close(force: true);
+      }
+      return;
+    }
+    if (_stopped) {
+      await socket.close();
+      return;
+    }
+    _socket = socket;
+    _status('connected $_endpoint');
+    _messages = socket
+        .handleError((Object error, StackTrace stack) {
+          if (error is! IOException) Error.throwWithStackTrace(error, stack);
+          _status('socket error $error; restart required');
+          unawaited(stop());
+        })
+        .asyncMap(_receive)
+        .listen(
+          (_) {},
+          onDone: () {
+            if (_stopped) return;
+            _status('socket closed; restart required');
+            unawaited(stop());
+          },
+        );
+    // No onError here. Application failures from asyncMap belong to the caller's zone.
+  }
+
+  Future<void> _receive(dynamic message) async {
+    if (_stopped) return;
+    if (message is! String) {
+      _status('input error expected WebSocket text');
+      return;
+    }
+    late final SceneDocument? next;
+    final preparation = () async {
+      try {
+        return await _prepare(message);
+      } on IOException catch (error) {
+        _status('input error $error');
+        return null;
+      } on FormatException catch (error) {
+        _status('input error $error');
+        return null;
+      }
+    }();
+    _preparing = preparation;
+    try {
+      next = await preparation;
+    } finally {
+      _preparing = null;
+    }
+    if (_stopped || next == null) return;
+    final current = _controller.document;
+    if (current == null) {
+      _controller.loadDocument(next);
+      _status('loadDocument');
+    } else {
+      final operations = _controller.applyDiff(diffScene(current, next), next);
+      _status('applyDiff ops=${operations.map((op) => op['op']).toList()}');
+    }
+  }
+
+  Future<SceneDocument> _prepare(String text) async {
+    final next = _parse(() => readFsceneLogged(text, log: _status));
+    final source = next.payloadSource;
+    if (source == null) return next;
+    final relative = Uri.parse(source);
+    if (source.isEmpty ||
+        relative.hasScheme ||
+        relative.hasAuthority ||
+        relative.path.startsWith('/') ||
+        source.contains('\\') ||
+        relative.hasQuery ||
+        relative.hasFragment ||
+        !source.endsWith('.fsceneb')) {
+      throw const FormatException(
+        'payloadSource must be a relative .fsceneb path',
+      );
+    }
+    final url = _endpoint.replace(
+      scheme: _endpoint.scheme == 'wss' ? 'https' : 'http',
+      path: '/payload',
+      queryParameters: {'path': source},
+    );
+    final request = await _client!.getUrl(url);
+    request.followRedirects = false;
+    final response = await request.close();
+    if (response.statusCode != HttpStatus.ok) {
+      await response.drain<void>();
+      throw HttpException('Payload HTTP ${response.statusCode}', uri: url);
+    }
+    final body = BytesBuilder(copy: false);
+    await for (final chunk in response) {
+      body.add(chunk);
+    }
+    final sidecar = _parse(() => readFsceneb(body.takeBytes()));
+    for (final required in next.payloads.values) {
+      final supplied = sidecar.payloads[required.id];
+      final bytes = supplied?.bytes;
+      if (supplied == null ||
+          bytes == null ||
+          required.encoding != supplied.encoding ||
+          required.layout != supplied.layout ||
+          required.format != supplied.format ||
+          required.width != supplied.width ||
+          required.height != supplied.height ||
+          required.length != supplied.length) {
+        throw FormatException(
+          'Missing bytes or mismatched descriptor for ${required.id}',
+        );
+      }
+      if (required.length != null && required.length != bytes.length) {
+        throw FormatException('Payload length mismatch for ${required.id}');
+      }
+      if (required.encoding == PayloadEncoding.image &&
+          required.format == 'rgba8') {
+        final width = required.width;
+        final height = required.height;
+        if (width == null ||
+            height == null ||
+            width <= 0 ||
+            height <= 0 ||
+            bytes.length != width * height * 4) {
+          throw FormatException(
+            'Invalid RGBA8 dimensions or bytes for ${required.id}',
+          );
+        }
+      }
+      required.bytes = bytes;
+    }
+    return next;
+  }
+
+  /// Revokes callbacks and application synchronously, then joins owned I/O.
+  Future<void> stop() {
+    _stopped = true;
+    _client?.close(force: true);
+    return _stopping ??= _stop();
+  }
+
+  Future<void> _stop() async {
+    final preparation = _preparing;
+    await Future.wait<void>([
+      if (_messages != null) _settleCancellation(_messages!.cancel()),
+      if (_socket != null) _settleCancellation(_socket!.close()),
+      if (_connecting != null) _settleCancellation(_connecting!),
+      // asyncMap cancellation does not join its converter future.
+      if (preparation != null) _settleCancellation(preparation),
+    ]);
+  }
+}
+
+SceneDocument _parse(SceneDocument Function() decode) {
+  try {
+    return decode();
+  } on FormatException {
+    rethrow;
+  } on FscenebFormatException catch (error) {
+    throw FormatException(error.toString());
+  } on FsceneFormatException catch (error) {
+    throw FormatException(error.toString());
+  } on FsceneVersionException catch (error) {
+    throw FormatException(error.toString());
+  } on FsceneUnsupportedFeatureException catch (error) {
+    throw FormatException(error.toString());
+  } on TypeError catch (error) {
+    throw FormatException(error.toString());
+  } on ArgumentError catch (error) {
+    throw FormatException(error.toString());
+  }
+}
+
+Future<void> _settleCancellation(Future<dynamic> work) async {
+  try {
+    await work;
+  } on IOException {
+    // Closing the owned client interrupts handshake and response reads.
+  }
+}
diff --git a/dart3d/tool/reload_host.dart b/dart3d/tool/reload_host.dart
new file mode 100644
index 0000000..92b5992
--- /dev/null
+++ b/dart3d/tool/reload_host.dart
@@ -0,0 +1,210 @@
+import 'dart:async';
+import 'dart:io';
+
+/// Loopback transport for one explicit authored file and one app session.
+final class SceneReloadHost {
+  SceneReloadHost._(this.source, this._parent, this._server, this._log);
+
+  final File source;
+  final Directory _parent;
+  final HttpServer _server;
+  final void Function(String) _log;
+  final _done = Completer<void>();
+  StreamSubscription<FileSystemEvent>? _watch;
+  StreamSubscription<HttpRequest>? _requests;
+  StreamSubscription<dynamic>? _messages;
+  WebSocket? _socket;
+  bool _claimed = false;
+  bool _closed = false;
+  Future<void>? _closing;
+
+  Uri get endpoint =>
+      Uri(scheme: 'ws', host: '127.0.0.1', port: _server.port, path: '/scene');
+  Future<void> get done => _done.future;
+
+  static Future<SceneReloadHost> start({
+    required String sourcePath,
+    required int port,
+    required void Function(String message) log,
+  }) async {
+    final file = File(sourcePath).absolute;
+    final parent = Directory(file.parent.resolveSymbolicLinksSync());
+    final source = File('${parent.path}/${file.uri.pathSegments.last}');
+    final server = await HttpServer.bind(InternetAddress.loopbackIPv4, port);
+    final host = SceneReloadHost._(source, parent, server, log);
+    try {
+      host._watch = parent
+          .watch(recursive: true)
+          .listen(
+            (_) => host._sendAuthoredText(),
+            onError: host._fail,
+            onDone: () => host._fail('watch closed'),
+          );
+      host._requests = server.listen(
+        host._accept,
+        onError: host._fail,
+        onDone: () => host._fail('server closed'),
+      );
+      return host;
+    } catch (_) {
+      await host.close();
+      rethrow;
+    }
+  }
+
+  Future<void> _accept(HttpRequest request) async {
+    try {
+      if (_closed) return;
+      if (request.method == 'GET' && request.uri.path == '/payload') {
+        await _serveSidecar(request);
+        return;
+      }
+      if (request.method != 'GET' || request.uri.path != '/scene') {
+        request.response.statusCode = HttpStatus.notFound;
+        await request.response.close();
+        return;
+      }
+      if (_claimed) {
+        request.response.statusCode = HttpStatus.conflict;
+        await request.response.close();
+        return;
+      }
+      _claimed = true;
+      final socket = await WebSocketTransformer.upgrade(request);
+      if (_closed) {
+        await socket.close();
+        return;
+      }
+      _socket = socket;
+      _messages = socket.listen(
+        (_) {},
+        onError: _fail,
+        onDone: () => _fail('peer closed'),
+      );
+      _log('connected');
+      _sendAuthoredText();
+    } on IOException catch (error) {
+      _fail(error);
+    }
+  }
+
+  Future<void> _serveSidecar(HttpRequest request) async {
+    try {
+      final key = request.uri.queryParameters['path'];
+      if (key == null || key.isEmpty) {
+        throw const FormatException('Missing payload path');
+      }
+      final relative = Uri.parse(key);
+      if (relative.hasScheme ||
+          relative.hasAuthority ||
+          relative.path.startsWith('/') ||
+          relative.hasQuery ||
+          relative.hasFragment ||
+          key.contains('\\') ||
+          !key.endsWith('.fsceneb')) {
+        throw const FormatException('Expected relative .fsceneb path');
+      }
+      // queryParameters decodes once. File paths preserve any remaining literal percent signs.
+      final file = File('${_parent.path}/$key');
+      final normalized = file.absolute.uri.normalizePath().toFilePath();
+      if (!normalized.startsWith('${_parent.path}/')) {
+        throw const FormatException('Payload escapes authored parent');
+      }
+      final resolved = file.resolveSymbolicLinksSync();
+      if (!resolved.startsWith('${_parent.path}/')) {
+        throw const FormatException('Payload symlink escapes authored parent');
+      }
+      final bytes = File(resolved).readAsBytesSync();
+      request.response.headers.contentType = ContentType.binary;
+      request.response.contentLength = bytes.length;
+      request.response.add(bytes);
+      _log('payload path=$key bytes=${bytes.length}');
+    } on FormatException catch (error) {
+      request.response.statusCode = HttpStatus.badRequest;
+      _log('path error $error');
+    } on FileSystemException catch (error) {
+      request.response.statusCode = error.osError?.errorCode == 2
+          ? HttpStatus.notFound
+          : HttpStatus.internalServerError;
+      _log('file error $error');
+    }
+    await request.response.close();
+  }
+
+  void _sendAuthoredText() {
+    if (_closed) return;
+    late final String text;
+    try {
+      text = source.readAsStringSync();
+    } on FileSystemException catch (error) {
+      _log('file error $error');
+      return;
+    }
+    final socket = _socket;
+    if (socket == null) return;
+    try {
+      socket.add(text);
+      _log('send chars=${text.length}');
+    } on IOException catch (error) {
+      _fail(error);
+    }
+  }
+
+  void _fail(Object error) {
+    if (_closed) return;
+    _log('error $error; restart required');
+    unawaited(close());
+  }
+
+  Future<void> close() {
+    _closed = true;
+    return _closing ??= _close();
+  }
+
+  Future<void> _close() async {
+    try {
+      await Future.wait<dynamic>([
+        if (_watch != null) _watch!.cancel(),
+        if (_socket != null) _socket!.close(),
+        if (_messages != null) _messages!.cancel(),
+        _server.close(force: true),
+        if (_requests != null) _requests!.cancel(),
+      ]);
+    } on IOException catch (error) {
+      _log('close error $error');
+    } finally {
+      _done.complete();
+    }
+  }
+}
+
+Future<void> main(List<String> args) async {
+  final port = args.length == 2 ? int.tryParse(args[1]) : null;
+  if (port == null || port < 0 || port > 65535) {
+    stderr.writeln('Usage: dart tool/reload_host.dart SOURCE PORT');
+    exitCode = 64;
+    return;
+  }
+  SceneReloadHost? host;
+  StreamSubscription<ProcessSignal>? interrupt;
+  StreamSubscription<ProcessSignal>? terminate;
+  try {
+    host = await SceneReloadHost.start(
+      sourcePath: args[0],
+      port: port,
+      log: stdout.writeln,
+    );
+    final running = host;
+    interrupt = ProcessSignal.sigint.watch().listen((_) => running.close());
+    terminate = ProcessSignal.sigterm.watch().listen((_) => running.close());
+    stdout.writeln('listening ${host.endpoint} source=${host.source.path}');
+    await host.done;
+  } on IOException catch (error) {
+    stderr.writeln('host error $error');
+    exitCode = 1;
+  } finally {
+    await host?.close();
+    await interrupt?.cancel();
+    await terminate?.cancel();
+  }
+}
diff --git a/dart3d/example/lib/dev_reload_main.dart b/dart3d/example/lib/dev_reload_main.dart
