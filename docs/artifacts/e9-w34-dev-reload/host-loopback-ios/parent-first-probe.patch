+import 'dart:async';
+import 'dart:io';
+
+import 'package:dart3d/dart3d.dart';
+
+class W34ReloadProbe {
+  W34ReloadProbe({required this.controller, required this.status});
+
+  final SceneController controller;
+  final void Function(String) status;
+  final _client = HttpClient();
+  StreamSubscription<dynamic>? _messages;
+  WebSocket? _socket;
+  bool _stopped = false;
+
+  Future<void> connect(String url) async {
+    status('connecting $url');
+    late final WebSocket socket;
+    try {
+      socket = await WebSocket.connect(url, customClient: _client);
+    } on IOException catch (error) {
+      if (!_stopped) status('connection error $error; restart required');
+      _client.close(force: true);
+      return;
+    }
+    if (_stopped) {
+      await socket.close();
+      return;
+    }
+    _socket = socket;
+    status('connected $url');
+    _messages = socket.listen(
+      _receive,
+      onError: (Object error) {
+        if (_stopped) return;
+        status('socket error $error; restart required');
+        unawaited(stop());
+      },
+      onDone: () {
+        if (_stopped) return;
+        status('socket closed; restart required');
+        unawaited(stop());
+      },
+    );
+  }
+
+  void _receive(dynamic message) {
+    if (_stopped) return;
+    if (message is! String) {
+      status('error expected WebSocket text');
+      return;
+    }
+    final requested = DateTime.now().toIso8601String();
+    late final SceneDocument next;
+    try {
+      next = readFsceneLogged(message, log: status);
+    } on FormatException catch (error) {
+      status('decode error $error');
+      return;
+    } on TypeError catch (error) {
+      status('decode error $error');
+      return;
+    } on ArgumentError catch (error) {
+      status('decode error $error');
+      return;
+    } on FsceneFormatException catch (error) {
+      status('decode error $error');
+      return;
+    } on FsceneVersionException catch (error) {
+      status('decode error $error');
+      return;
+    } on FsceneUnsupportedFeatureException catch (error) {
+      status('decode error $error');
+      return;
+    }
+    if (controller.document == null) {
+      controller.loadDocument(next);
+      status('loadDocument request=$requested');
+    } else {
+      final operations = controller.applyDiff(
+        diffScene(controller.document!, next),
+        next,
+      );
+      status(
+        'applyDiff request=$requested '
+        'ops=${operations.map((op) => op['op']).toList()}',
+      );
+    }
+  }
+
+  Future<void> stop() async {
+    _stopped = true;
+    _client.close(force: true);
+    await _messages?.cancel();
+    await _socket?.close();
+  }
+}
