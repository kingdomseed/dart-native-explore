+  test(
+    'stop during real pending handshake cannot reach disposed controller',
+    () async {
+      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+      final request = Completer<HttpRequest>();
+      final requests = server.listen(request.complete);
+      try {
+        probe = W34ReloadProbe(controller: controller, status: status.add);
+        final connecting = probe!.connect('ws://127.0.0.1:${server.port}');
+        final pending = await request.future.timeout(
+          const Duration(seconds: 5),
+        );
+        await probe!.stop();
+        controller.detachElement(element);
+        controller.dispose();
+        controller = SceneController();
+        await connecting.timeout(const Duration(seconds: 5));
+        await pending.response.close();
+        expect(controller.document, isNull);
+        expect(element.sent, isEmpty);
+        expect(status.values, hasLength(1));
+      } finally {
+        await server.close(force: true);
+        await requests.cancel();
+      }
+    },
+  );
