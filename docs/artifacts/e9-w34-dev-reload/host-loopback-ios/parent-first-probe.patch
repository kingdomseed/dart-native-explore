+  test('CLI SIGTERM closes its watcher/server and exits', () async {
+    final executable = File(Platform.resolvedExecutable);
+    // dn test runs under flutter_tester; this process needs the host SDK Dart.
+    final dart = executable.uri.pathSegments.last == 'flutter_tester'
+        ? executable.uri.resolve('../../../dart-sdk/bin/dart').toFilePath()
+        : executable.path;
+    final process = await Process.start(dart, [
+      'run',
+      'tool/w34_reload_host.dart',
+      source.path,
+      '0',
+    ]);
+    final errors = process.stderr.transform(utf8.decoder).join();
+    final lines = StreamIterator(
+      process.stdout.transform(utf8.decoder).transform(const LineSplitter()),
+    );
+    try {
+      do {
+        expect(
+          await lines.moveNext().timeout(const Duration(seconds: 8)),
+          isTrue,
+        );
+      } while (!lines.current.startsWith('listening '));
+      final url = lines.current.split(' ')[1];
+      expect(lines.current, startsWith('listening ws://127.0.0.1:'));
+      expect(process.kill(ProcessSignal.sigterm), isTrue);
+      expect(await process.exitCode.timeout(const Duration(seconds: 5)), 0);
+      expect(await errors, isEmpty);
+      final rebound = await HttpServer.bind(
+        InternetAddress.loopbackIPv4,
+        Uri.parse(url).port,
+      );
+      await rebound.close(force: true);
+    } finally {
+      process.kill(ProcessSignal.sigterm);
+      await process.exitCode;
+      await lines.cancel();
+    }
+  });
