+import 'dart:async';
+import 'dart:io';
+
+class W34ReloadHost {
+  W34ReloadHost._(this.source, this._server, this.log);
+
+  final File source;
+  final HttpServer _server;
+  final void Function(String) log;
+  final _done = Completer<void>();
+  StreamSubscription<FileSystemEvent>? _watch;
+  StreamSubscription<HttpRequest>? _requests;
+  StreamSubscription<dynamic>? _messages;
+  WebSocket? _socket;
+  String? _lastSent;
+  bool _claimed = false;
+  bool _closed = false;
+  Future<void>? _closing;
+
+  String get url => 'ws://127.0.0.1:${_server.port}';
+  Future<void> get done => _done.future;
+
+  static Future<W34ReloadHost> start({
+    required String sourcePath,
+    required int port,
+    required void Function(String) log,
+  }) async {
+    final file = File(sourcePath).absolute;
+    final parent = Directory(file.parent.resolveSymbolicLinksSync());
+    final source = File.fromUri(parent.uri.resolve(file.uri.pathSegments.last));
+    final server = await HttpServer.bind(InternetAddress.loopbackIPv4, port);
+    final host = W34ReloadHost._(source, server, log);
+    try {
+      host._watch = parent
+          .watch(recursive: false)
+          .listen(
+            (event) {
+              if (host._closed) return;
+              final destination = event is FileSystemMoveEvent
+                  ? event.destination
+                  : null;
+              if (event.path == source.path ||
+                  event.path == parent.path ||
+                  destination == source.path) {
+                host._send();
+              }
+            },
+            onError: host._fail,
+            onDone: () => host._fail('watch closed'),
+          );
+      // Subscribe before reading so saves cannot fall into a startup gap.
+      source.readAsStringSync();
+      host._requests = server.listen(
+        host._accept,
+        onError: host._fail,
+        onDone: () => host._fail('server closed'),
+      );
+      return host;
+    } catch (_) {
+      await host.close();
+      rethrow;
+    }
+  }
+
+  Future<void> _accept(HttpRequest request) async {
+    if (_closed || _claimed) {
+      request.response.statusCode = HttpStatus.conflict;
+      await request.response.close();
+      return;
+    }
+    _claimed = true;
+    late final WebSocket socket;
+    try {
+      socket = await WebSocketTransformer.upgrade(request);
+    } on WebSocketException catch (error) {
+      _fail(error);
+      return;
+    } on IOException catch (error) {
+      _fail(error);
+      return;
+    }
+    if (_closed) {
+      await socket.close();
+      return;
+    }
+    _socket = socket;
+    _messages = socket.listen(
+      (_) {},
+      onError: _fail,
+      onDone: () => _fail('peer closed'),
+    );
+    log('connected ${DateTime.now().toIso8601String()}');
+    _send();
+  }
+
+  void _send() {
+    if (_closed) return;
+    late final String text;
+    try {
+      text = source.readAsStringSync();
+    } on FileSystemException catch (error) {
+      log('file error $error');
+      return;
+    }
+    final socket = _socket;
+    if (socket == null || text == _lastSent) return;
+    try {
+      socket.add(text);
+      _lastSent = text;
+      log('send ${DateTime.now().toIso8601String()} chars=${text.length}');
+    } on IOException catch (error) {
+      _fail(error);
+    }
+  }
+
+  void _fail(Object error) {
+    if (_closed) return;
+    log('error $error; restart required');
+    unawaited(close());
+  }
+
+  Future<void> close() {
+    _closed = true;
+    return _closing ??= _close();
+  }
+
+  Future<void> _close() async {
+    await _watch?.cancel();
+    await _socket?.close();
+    await _messages?.cancel();
+    await _server.close(force: true);
+    await _requests?.cancel();
+    _done.complete();
+  }
+}
+
+Future<void> main(List<String> args) async {
+  if (args.length != 2 || int.tryParse(args[1]) == null) {
+    stderr.writeln('Usage: dart run tool/w34_reload_host.dart SOURCE PORT');
+    exitCode = 64;
+    return;
+  }
+  W34ReloadHost? host;
+  StreamSubscription<ProcessSignal>? interrupt;
+  StreamSubscription<ProcessSignal>? terminate;
+  try {
+    host = await W34ReloadHost.start(
+      sourcePath: args[0],
+      port: int.parse(args[1]),
+      log: stdout.writeln,
+    );
+    final running = host;
+    interrupt = ProcessSignal.sigint.watch().listen((_) => running.close());
+    terminate = ProcessSignal.sigterm.watch().listen((_) => running.close());
+    stdout.writeln('listening ${host.url} source=${host.source.path}');
+    await host.done;
+  } on IOException catch (error) {
+    stderr.writeln('host error $error');
+    exitCode = 1;
+  } finally {
+    await host?.close();
+    await interrupt?.cancel();
+    await terminate?.cancel();
+  }
+}
