+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:dart3d/dart3d.dart';
+import 'package:dart3d/src/protocol.dart';
+import 'package:dart3d/src/scene_view.dart';
+import 'package:test/test.dart';
+
+import 'package:dart3d_example/w34_reload_probe.dart';
+import '../tool/w34_reload_host.dart';
+
+class RecordingElement extends SceneViewElement {
+  RecordingElement(SceneController controller)
+    : super(SceneViewLeaf(controller: controller));
+
+  final sent = <({int tag, Uint8List data})>[];
+
+  @override
+  void sendMutation(int tag, Uint8List bytes) =>
+      sent.add((tag: tag, data: Uint8List.fromList(bytes)));
+
+  List<Map<String, dynamic>> get commands => [
+    for (final mutation in sent.where((m) => m.tag == D3Protocol.command))
+      ..._flatten(
+        jsonDecode(utf8.decode(mutation.data)) as Map<String, dynamic>,
+      ),
+  ];
+
+  List<Map<String, dynamic>> _flatten(Map<String, dynamic> op) =>
+      op['op'] == 'batch'
+      ? (op['ops'] as List).cast<Map<String, dynamic>>()
+      : [op];
+}
+
+class Messages {
+  final values = <String>[];
+  final events = StreamController<String>.broadcast(sync: true);
+
+  void add(String value) {
+    values.add(value);
+    events.add(value);
+  }
+
+  Future<String> next(String prefix) => events.stream
+      .firstWhere((message) => message.startsWith(prefix))
+      .timeout(const Duration(seconds: 8));
+}
+
+void main() {
+  late Directory directory;
+  late File source;
+  late String initial;
+  late SceneController controller;
+  late RecordingElement element;
+  late Messages status;
+  late Messages hostLog;
+  W34ReloadHost? host;
+  W34ReloadProbe? probe;
+
+  setUp(() async {
+    directory = Directory(
+      (await Directory.systemTemp.createTemp(
+        'w34-transport-',
+      )).resolveSymbolicLinksSync(),
+    );
+    source = File('${directory.path}/authored.fscene');
+    initial = File('tool/fixtures/w34_reload.fscene').readAsStringSync();
+    source.writeAsStringSync(initial);
+    controller = SceneController();
+    element = RecordingElement(controller);
+    controller.attachElement(element);
+    status = Messages();
+    hostLog = Messages();
+  });
+
+  tearDown(() async {
+    await probe?.stop();
+    await host?.close();
+    controller.detachElement(element);
+    controller.dispose();
+    await status.events.close();
+    await hostLog.events.close();
+    await directory.delete(recursive: true);
+    host = null;
+    probe = null;
+  });
+
+  Future<void> start() async {
+    host = await W34ReloadHost.start(
+      sourcePath: source.path,
+      port: 0,
+      log: hostLog.add,
+    );
+    probe = W34ReloadProbe(controller: controller, status: status.add);
+    final loaded = status.next('loadDocument');
+    await probe!.connect(host!.url);
+    await loaded;
+  }
+
+  Future<void> save(String text, {String expected = 'applyDiff'}) async {
+    final applied = status.next(expected);
+    source.writeAsStringSync(text, flush: true);
+    await applied;
+  }
+
+  Map<String, dynamic> document() =>
+      jsonDecode(writeFsceneWithExtensions(controller.document!))
+          as Map<String, dynamic>;
+
+  String edit({bool blue = false, double exposure = 1}) {
+    final value = jsonDecode(initial) as Map<String, dynamic>;
+    final resources = value['resources'] as Map;
+    if (blue) {
+      resources['mat:01VK6D0000000']['properties']['baseColor']['c'] = [
+        0.03,
+        0.08,
+        0.7,
+        1.0,
+      ];
+    }
+    resources['env:01VK6D000000A']['exposure'] = exposure;
+    return jsonEncode(value);
+  }
+
+  test(
+    'real watch and socket load once, diff color/exposure, restore fixed camera',
+    () async {
+      await start();
+      expect(
+        element.sent.where((m) => m.tag == D3Protocol.loadScene),
+        hasLength(1),
+      );
+      final camera = document()['nodes']['n:01VK6D0000008'];
+      element.sent.clear();
+
+      await save(edit(blue: true));
+      expect(element.commands.map((op) => op['op']), [
+        'upsertResource',
+        'updateNode',
+      ]);
+      expect(element.commands.first['id'], 'mat:01VK6D0000000');
+      expect(
+        document()['resources']['mat:01VK6D0000000']['properties']['baseColor'],
+        {
+          'c': [0.03, 0.08, 0.7, 1.0],
+        },
+      );
+      expect(document()['nodes']['n:01VK6D0000008'], camera);
+      element.sent.clear();
+
+      await save(edit(blue: true, exposure: .2));
+      expect(element.commands.map((op) => op['op']), [
+        'upsertResource',
+        'updateStage',
+      ]);
+      expect(element.commands.first['id'], 'env:01VK6D000000A');
+      expect(document()['resources']['env:01VK6D000000A']['exposure'], .2);
+      expect(document()['nodes']['n:01VK6D0000008'], camera);
+      element.sent.clear();
+
+      await save(initial);
+      expect(element.commands.map((op) => op['op']), [
+        'upsertResource',
+        'upsertResource',
+        'updateNode',
+        'updateStage',
+      ]);
+      expect(
+        document(),
+        jsonDecode(writeFsceneWithExtensions(readFsceneLogged(initial))),
+      );
+      expect(element.sent.where((m) => m.tag == D3Protocol.loadScene), isEmpty);
+    },
+  );
+
+  test(
+    'authored decode errors retain the same document and later saves recover',
+    () async {
+      await start();
+      final accepted = controller.document;
+      element.sent.clear();
+      final wrong = initial.replaceFirst('"d": 0.8', '"d": "wrong"');
+      final shortColor = initial.replaceFirst(
+        '[0.7, 0.08, 0.03, 1.0]',
+        '[0.7]',
+      );
+      for (final invalid in ['{', wrong, shortColor, '[]']) {
+        await save(invalid, expected: 'decode error');
+        expect(controller.document, same(accepted));
+        expect(element.sent, isEmpty);
+      }
+      await save(edit(blue: true));
+      expect(element.commands.map((op) => op['op']), [
+        'upsertResource',
+        'updateNode',
+      ]);
+    },
+  );
+
+  test(
+    'actual rename save reloads; unrelated sibling save emits no mutation',
+    () async {
+      await start();
+      element.sent.clear();
+      final applied = status.next('applyDiff');
+      final replacement = File('${directory.path}/replacement.tmp');
+      replacement.writeAsStringSync(edit(blue: true), flush: true);
+      replacement.renameSync(source.path);
+      await applied;
+      expect(element.commands.map((op) => op['op']), [
+        'upsertResource',
+        'updateNode',
+      ]);
+      element.sent.clear();
+      final sentCount = hostLog.values
+          .where((m) => m.startsWith('send '))
+          .length;
+      File(
+        '${directory.path}/unrelated.fscene',
+      ).writeAsStringSync('{unrelated');
+      await Future<void>.delayed(const Duration(milliseconds: 800));
+      expect(element.sent, isEmpty);
+      expect(
+        hostLog.values.where((m) => m.startsWith('send ')),
+        hasLength(sentCount),
+      );
+    },
+  );
+
+  test(
+    'missing source during rename surfaces error then recovers on real event',
+    () async {
+      await start();
+      element.sent.clear();
+      final error = hostLog.next('file error');
+      source.renameSync('${directory.path}/moved.fscene');
+      await error;
+      expect(element.sent, isEmpty);
+      await save(edit(blue: true));
+      expect(element.commands.map((op) => op['op']), [
+        'upsertResource',
+        'updateNode',
+      ]);
+    },
+  );
+
+  test(
+    'stop before controller disposal prevents later file-save callbacks',
+    () async {
+      await start();
+      await probe!.stop();
+      controller.detachElement(element);
+      controller.dispose();
+      // Teardown owns a fresh unattached controller after this lifetime check.
+      controller = SceneController();
+      element.sent.clear();
+      final count = status.values.length;
+      source.writeAsStringSync(edit(blue: true));
+      await host!.done.timeout(const Duration(seconds: 5));
+      await Future<void>.delayed(const Duration(milliseconds: 800));
+      expect(element.sent, isEmpty);
+      expect(status.values, hasLength(count));
+    },
+  );
+
+  test('peer disconnect terminates host and releases listening port', () async {
+    host = await W34ReloadHost.start(
+      sourcePath: source.path,
+      port: 0,
+      log: hostLog.add,
+    );
+    final uri = Uri.parse(host!.url);
+    final peer = await WebSocket.connect(host!.url);
+    final messages = peer.listen((_) {});
+    await peer.close();
+    await host!.done.timeout(const Duration(seconds: 5));
+    await messages.cancel();
+    expect(hostLog.values, contains('error peer closed; restart required'));
+    final rebound = await HttpServer.bind(
+      InternetAddress.loopbackIPv4,
+      uri.port,
+    );
+    await rebound.close(force: true);
+  });
+
+  test(
+    'host close surfaces receiver disconnect and releases resources',
+    () async {
+      await start();
+      final closed = status.next('socket closed');
+      await host!.close();
+      await closed;
+      expect(status.values.last, contains('restart required'));
+    },
+  );
