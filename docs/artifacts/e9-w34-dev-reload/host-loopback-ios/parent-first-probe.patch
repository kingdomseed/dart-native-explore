+  test(
+    'receiver rejects binary messages and accepts subsequent text',
+    () async {
+      final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+      final upgraded = Completer<WebSocket>();
+      final requests = server.listen((request) async {
+        upgraded.complete(await WebSocketTransformer.upgrade(request));
+      });
+      WebSocket? peer;
+      StreamSubscription<dynamic>? messages;
+      try {
+        probe = W34ReloadProbe(controller: controller, status: status.add);
+        await probe!.connect('ws://127.0.0.1:${server.port}');
+        peer = await upgraded.future;
+        messages = peer.listen((_) {});
+        final error = status.next('error expected WebSocket text');
+        peer.add([1, 2, 3]);
+        await error;
+        expect(controller.document, isNull);
+        expect(element.sent, isEmpty);
+        final loaded = status.next('loadDocument');
+        peer.add(initial);
+        await loaded;
+        expect(
+          element.sent.where((m) => m.tag == D3Protocol.loadScene),
+          hasLength(1),
+        );
+      } finally {
+        await probe?.stop();
+        await peer?.close();
+        await messages?.cancel();
+        await server.close(force: true);
+        await requests.cancel();
+      }
+    },
+  );
