+    val rgba: List<Int>,
+)
+
+private data class RawMaskChannelRange(val min: Int, val max: Int)
+
+private data class RawMaskReadback(
+    val width: Int,
+    val height: Int,
+    val rowOrigin: String,
+    val rgba: ByteArray,
+    val channelRanges: List<RawMaskChannelRange>,
+    val maxRgbDifference: Int,
+    val maskBins: List<Int>,
+    val samples: List<RawMaskPixel>,
+) {
+    fun summary(): String =
+        "rgbaRanges=${channelRanges.joinToString(prefix = "[", postfix = "]")}" +
+            " maxRgbDifference=$maxRgbDifference" +
+            " alphaRange=${channelRanges[3].min}..${channelRanges[3].max}" +
+            " maskBins=${maskBins.joinToString(prefix = "[", postfix = "]")}" +
+            " samples=${samples.joinToString { sample ->
+                "${sample.name}@${sample.x},${sample.y}=${sample.rgba}"
+            }}"
+}
+
+private val RAW_MASK_SAMPLE_POINTS = listOf(
+    RawMaskSamplePoint("receiver-nw", 16, 16),
+    RawMaskSamplePoint("receiver-ne", 240, 16),
+    RawMaskSamplePoint("receiver-sw", 16, 240),
+    RawMaskSamplePoint("receiver-se", 240, 240),
+    RawMaskSamplePoint("caster-projection", 143, 133),
+)
+
+private fun analyzeRawMask(bytes: ByteArray): RawMaskReadback {
+    val minima = IntArray(4) { 255 }
+    val maxima = IntArray(4)
+    val maskBins = IntArray(6)
+    var maxRgbDifference = 0
+    for (offset in bytes.indices step 4) {
+        val r = bytes[offset].toInt() and 0xFF
+        val g = bytes[offset + 1].toInt() and 0xFF
+        val b = bytes[offset + 2].toInt() and 0xFF
+        val a = bytes[offset + 3].toInt() and 0xFF
+        val pixel = intArrayOf(r, g, b, a)
+        for (channel in pixel.indices) {
+            minima[channel] = minOf(minima[channel], pixel[channel])
+            maxima[channel] = maxOf(maxima[channel], pixel[channel])
+        }
+        maxRgbDifference = maxOf(
+            maxRgbDifference, abs(r - g), abs(g - b), abs(b - r))
+        maskBins[when (r) {
+            0 -> 0
+            in 1..63 -> 1
+            in 64..127 -> 2
+            in 128..191 -> 3
+            in 192..254 -> 4
+            else -> 5
+        }]++
+    }
+    val pixels = RAW_MASK_SAMPLE_POINTS.map { point ->
+        val offset = (point.y * PROBE_SIZE + point.x) * 4
+        RawMaskPixel(
+            point.name,
+            point.x,
+            point.y,
+            (0..3).map { channel -> bytes[offset + channel].toInt() and 0xFF },
+        )
+    }
+    return RawMaskReadback(
+        PROBE_SIZE,
+        PROBE_SIZE,
+        "top-left",
+        bytes,
+        minima.indices.map { RawMaskChannelRange(minima[it], maxima[it]) },
+        maxRgbDifference,
+        maskBins.toList(),
+        pixels,
+    )
+}
 
