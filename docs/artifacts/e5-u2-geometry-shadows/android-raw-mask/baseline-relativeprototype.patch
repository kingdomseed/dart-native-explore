+    private fun requestRawMaskReadback(renderer: Renderer) {
+        if (!readbackState.compareAndSet(
+                ReadbackState.NOT_REQUESTED, ReadbackState.PENDING)) return
+
+        val storage = ByteBuffer.allocateDirect(PROBE_SIZE * PROBE_SIZE * 4)
+        readbackStorage = storage
+        val backend = engine.backend.toString().lowercase(Locale.ROOT)
+        val descriptor = PixelBufferDescriptor(
+            storage,
+            Texture.Format.RGBA,
+            Texture.Type.UBYTE,
+            1,
+            0,
+            0,
+            PROBE_SIZE,
+            RAW_READBACK_EXECUTOR,
+        ) {
+            val rgba = ByteArray(storage.capacity())
+            storage.duplicate().apply { clear() }.get(rgba)
+            readbackStorage = null
+            readbackState.updateAndGet { state ->
+                when (state) {
+                    ReadbackState.PENDING -> ReadbackState.COMPLETE
+                    ReadbackState.DESTROY_PENDING -> ReadbackState.DESTROY_READY
+                    else -> state
+                }
+            }
+            Thread({
+                try {
+                    exportRawMaskReadback(rgba, backend)
+                } finally {
+                    mainHandler.post(onReadbackComplete)
+                }
+            }, "dart3d-raw-mask-export").start()
+        }
+        try {
+            renderer.readPixels(
+                target!!.rt, 0, 0, PROBE_SIZE, PROBE_SIZE, descriptor)
+        } catch (error: RuntimeException) {
+            readbackStorage = null
+            if (readbackState.compareAndSet(
+                    ReadbackState.PENDING, ReadbackState.FAILED)) {
+                Log.e(
+                    TAG,
+                    "shadow catcher raw mask readback submission failed" +
+                        " light=${config.lightCase.label} backend=$backend",
+                    error,
+                )
+            }
+        }
+    }
+
+    private fun exportRawMaskReadback(bytes: ByteArray, backend: String) {
+        val readback = analyzeRawMask(bytes)
+        Log.i(
+            TAG,
+            "shadow catcher raw mask complete" +
+                " light=${config.lightCase.label} backend=$backend" +
+                " size=${readback.width}x${readback.height}" +
+                " rowOrigin=${readback.rowOrigin}" +
+                " maskChannel=R maskMeaning=occlusion(1-visibility)" +
+                " captureAlpha=opaque-material-alpha ${readback.summary()}",
+        )
+        val directory = appContext.getExternalFilesDir("dart3d-raw-mask")
+        if (directory == null) {
+            Log.e(TAG, "shadow catcher raw mask external files directory unavailable")
+            return
+        }
+        if (!directory.exists() && !directory.mkdirs()) {
+            Log.e(TAG, "shadow catcher raw mask directory could not be created")
+            return
+        }
+        val stem = "raw-mask-${config.lightCase.label}-$backend"
+        val rawFile = File(directory, "$stem.rgba")
+        val metadataFile = File(directory, "$stem.txt")
+        try {
+            rawFile.writeBytes(readback.rgba)
+            metadataFile.writeText(
+                buildString {
+                    appendLine("light=${config.lightCase.label}")
+                    appendLine("backend=$backend")
+                    appendLine("width=${readback.width}")
+                    appendLine("height=${readback.height}")
+                    appendLine("format=RGBA/UBYTE")
+                    appendLine("rowStrideBytes=${readback.width * 4}")
+                    appendLine("bufferRowOrigin=${readback.rowOrigin}")
+                    appendLine("readPixelsOffsetOrigin=bottom-left")
+                    appendLine("maskChannel=R")
+                    appendLine(
+                        "maskMeaning=occlusion=1-LightData.visibility;" +
+                            " 0=unshadowed; 255=fully-shadowed")
+                    appendLine(
+                        "captureAlphaMeaning=opaque source material alpha;" +
+                            " expected=255; independent of mask")
+                    appendLine("cameraEye=(0,6,0); target=(0,0,0); up=(0,0,-1)")
+                    appendLine("captureOrtho=-2.1..2.1; clip=0.1..12.0")
+                    appendLine("casterCenterWorld=(0.24,0.78,0.08)")
+                    appendLine(
+                        "casterCenterPixelApprox=(143,133); origin=top-left")
+                    appendLine(
+                        "channelRanges=" + readback.channelRanges.joinToString())
+                    appendLine("maxRgbDifference=${readback.maxRgbDifference}")
+                    appendLine(
+                        "maskBins(0,1-63,64-127,128-191,192-254,255)=" +
+                            readback.maskBins.joinToString())
+                    for (sample in readback.samples) {
+                        appendLine(
+                            "sample.${sample.name}=${sample.x},${sample.y}:" +
+                                sample.rgba.joinToString(","))
+                    }
+                },
+                Charsets.UTF_8,
+            )
+            Log.i(
+                TAG,
+                "shadow catcher raw mask files raw=${rawFile.absolutePath}" +
+                    " metadata=${metadataFile.absolutePath}",
+            )
+        } catch (error: IOException) {
+            Log.e(TAG, "shadow catcher raw mask export failed", error)
+        }
+    }
