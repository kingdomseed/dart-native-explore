+package com.jasonholtdigital.dart3d
+
+import android.util.Log
+import java.io.File
+import java.io.IOException
+import java.nio.ByteBuffer
+import java.security.MessageDigest
+
+internal fun exportBakedCatcherStage(
+    directory: File?,
+    name: String,
+    size: Int,
+    buffer: ByteBuffer,
+    metadata: String,
+) {
+    try {
+        if (directory == null) {
+            throw IOException("baked stage external files directory unavailable")
+        }
+        directory.mkdirs()
+        if (!directory.isDirectory) {
+            throw IOException("baked stage directory could not be created")
+        }
+        val bytes = ByteArray(size * size * 4)
+        buffer.rewind()
+        buffer.get(bytes)
+        val summary = buildString {
+            for (channel in 0..3) {
+                var min = 255
+                var max = 0
+                var zeros = 0
+                var full = 0
+                for (pixel in 0 until size * size) {
+                    val value = bytes[pixel * 4 + channel].toInt() and 255
+                    min = minOf(min, value)
+                    max = maxOf(max, value)
+                    if (value == 0) zeros++
+                    if (value == 255) full++
+                }
+                appendLine("${"RGBA"[channel]} min=$min max=$max zeros=$zeros full=$full pixels=${size * size}")
+            }
+        }
+        val samples = buildString {
+            for ((label, xy) in listOf(
+                "topLeft" to (0 to 0),
+                "topMiddle" to (size / 2 to 0),
+                "topRight" to (size - 1 to 0),
+                "leftMiddle" to (0 to size / 2),
+                "center" to (size / 2 to size / 2),
+                "rightMiddle" to (size - 1 to size / 2),
+                "bottomLeft" to (0 to size - 1),
+                "bottomMiddle" to (size / 2 to size - 1),
+                "bottomRight" to (size - 1 to size - 1),
+                "quarter" to (size / 4 to size / 4),
+                "threeQuarter" to (3 * size / 4 to 3 * size / 4),
+            )) {
+                val offset = (xy.second * size + xy.first) * 4
+                appendLine("sample.$label x=${xy.first} y=${xy.second} rgba=" +
+                    (0..3).joinToString(",") {
+                        (bytes[offset + it].toInt() and 255).toString()
+                    })
+            }
+        }
+        val digest = MessageDigest.getInstance("SHA-256").digest(bytes)
+            .joinToString("") { "%02x".format(it.toInt() and 255) }
+        File(directory, "$name.rgba").writeBytes(bytes)
+        File(directory, "$name.txt").writeText(buildString {
+            append(metadata)
+            appendLine("stage=$name width=$size height=$size format=RGBA/UBYTE alignment=1 stridePixels=$size")
+            appendLine("rowStrideBytes=${size * 4} byteCount=${bytes.size} sha256=$digest")
+            appendLine("bufferRowOrigin=top-left per pinned Renderer contract; bytes unmodified")
+            appendLine("readPixelsOffsetOrigin=bottom-left x=0 y=0")
+            appendLine("maskChannel=R; shadow amount; 0=unshadowed 255=full; capture A is independent opaque material alpha")
+            append(summary)
+            append(samples)
+        })
+        // The completion marker follows both writes, so the parent can pull safely.
+        Log.i("dart3d", "baked stage files complete stage=$name directory=${directory.absolutePath} sha256=$digest " +
+            summary.trim().replace('\n', ';'))
+    } catch (error: IOException) {
+        Log.e("dart3d", "baked stage export failed stage=$name", error)
+    }
+}
