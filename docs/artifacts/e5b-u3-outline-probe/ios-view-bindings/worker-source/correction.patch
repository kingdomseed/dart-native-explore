--- /dev/null
+++ b/dart3d/example/lib/u3_outline_views_main.dart
@@ -0,0 +1,183 @@
+import 'package:dart3d/dart3d.dart';
+import 'package:dartnative/dartnative.dart';
+
+import 'dartnative_plugin_registrant.dart';
+import 'u3_outline_views_scene.dart';
+
+const _single = bool.fromEnvironment('DART3D_U3_OUTLINE_SINGLE');
+const _msaa = bool.fromEnvironment('DART3D_U3_OUTLINE_TARGET_MSAA');
+const _modeName = String.fromEnvironment(
+  'DART3D_U3_OUTLINE_MODE',
+  defaultValue: 'off',
+);
+const _bootMode = _modeName == 'outline'
+    ? U3OutlineMode.outline
+    : _modeName == 'control'
+    ? U3OutlineMode.control
+    : U3OutlineMode.off;
+
+void main() {
+  DartNativePluginRegistrant.registerAll();
+  runApp(const _OutlineScreen());
+}
+
+class _OutlineScreen extends StatefulWidget {
+  const _OutlineScreen();
+  @override
+  State<_OutlineScreen> createState() => _OutlineScreenState();
+}
+
+class _OutlineScreenState extends State<_OutlineScreen> {
+  final _controller = SceneController();
+  final _document = buildU3OutlineViewsDocument(
+    single: _single,
+    targetMsaa: _msaa,
+    mode: _bootMode,
+  );
+  U3OutlineMode _mode = _bootMode;
+  bool _cameraB = false;
+  bool _playing = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _controller.loadDocument(_document);
+  }
+
+  @override
+  void dispose() {
+    _controller.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+    brightness: Brightness.dark,
+    backgroundColor: const Color(0xFF14171C),
+    body: Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Expanded(
+          child: SceneView(controller: _controller, quality: SceneQuality.high),
+        ),
+        Padding(
+          padding: const EdgeInsets.all(8),
+          child: Column(
+            children: [
+              SizedBox(
+                height: 44,
+                child: Row(
+                  children: [
+                    for (final mode in U3OutlineMode.values)
+                      Expanded(
+                        child: Button(
+                          title: mode.name,
+                          variant: _mode == mode
+                              ? ButtonVariant.filled
+                              : ButtonVariant.plain,
+                          onPressed: () {
+                            setState(() => _mode = mode);
+                            setU3OutlineMode(
+                              _controller,
+                              mode,
+                              cameraB: _cameraB,
+                            );
+                          },
+                        ),
+                      ),
+                  ],
+                ),
+              ),
+              SizedBox(
+                height: 44,
+                child: Row(
+                  children: [
+                    Expanded(
+                      child: Button(
+                        title: 'Set colors',
+                        onPressed: () => setU3OutlineColors(_controller),
+                      ),
+                    ),
+                    Expanded(
+                      child: Button(
+                        title: 'Clear',
+                        onPressed: () => clearU3OutlineColors(_controller),
+                      ),
+                    ),
+                    Expanded(
+                      child: Button(
+                        title: 'Render target',
+                        onPressed: () => _controller.renderTexture(
+                          _document.resources.values
+                              .whereType<RenderTextureResource>()
+                              .single
+                              .id,
+                        ),
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+              SizedBox(
+                height: 44,
+                child: Row(
+                  children: [
+                    Expanded(
+                      child: Button(
+                        title: _cameraB ? 'Camera B' : 'Camera A',
+                        onPressed: () {
+                          setState(() => _cameraB = !_cameraB);
+                          setU3OutlineMode(
+                            _controller,
+                            _mode,
+                            cameraB: _cameraB,
+                          );
+                          setU3OutlineCameraPose(
+                            _controller,
+                            alternate: _cameraB,
+                            single: _single,
+                          );
+                        },
+                      ),
+                    ),
+                    Expanded(
+                      child: Button(
+                        title: _playing ? 'Pause' : 'Play',
+                        onPressed: () {
+                          setState(() => _playing = !_playing);
+                          final clip = _document.animations.keys.single;
+                          if (_playing) {
+                            _controller.playAnimation(
+                              clip,
+                              weight: 1,
+                              loop: true,
+                            );
+                          } else {
+                            _controller.pauseAnimation(clip);
+                          }
+                        },
+                      ),
+                    ),
+                    Expanded(
+                      child: Button(
+                        title: 'Rebind views',
+                        onPressed: () =>
+                            _controller.updateViews(_document.views),
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+              Text(
+                '${_single ? "Host" : "Two siblings"}; target 96×72 ${_msaa ? "MSAA4x" : "none"}.\n'
+                'Orange mesh + blue batch. Authored child stays unselected.\n'
+                'Manual target changes only after Render target. Raw rows: U3OV logs.',
+                style: const TextStyle(color: Color(0xFFCCCCCC), fontSize: 11),
+              ),
+            ],
+          ),
+        ),
+      ],
+    ),
+  );
+}
diff --git a/dart3d/example/lib/u3_outline_views_scene.dart b/dart3d/example/lib/u3_outline_views_scene.dart
new file mode 100644
--- /dev/null
+++ b/dart3d/example/lib/u3_outline_views_scene.dart
@@ -0,0 +1,277 @@
+import 'dart:typed_data';
+
+import 'package:dart3d/dart3d.dart';
+import 'package:vector_math/vector_math.dart';
+
+import 'light_aim.dart';
+
+const u3OutlineMarker = '__u3_outline_views_probe__';
+const u3OutlineMesh = LocalId(0x75336f76, 1);
+const u3OutlineBatch = LocalId(0x75336f76, 2);
+const u3OutlineChild = LocalId(0x75336f76, 3);
+const u3OutlineControl = LocalId(0x75336f76, 4);
+const u3OutlineCameraA = LocalId(0x75336f76, 5);
+const u3OutlineCameraB = LocalId(0x75336f76, 6);
+const u3OutlineCameraTarget = LocalId(0x75336f76, 7);
+
+enum U3OutlineMode { off, control, outline }
+
+SceneDocument buildU3OutlineViewsDocument({
+  bool single = false,
+  bool targetMsaa = false,
+  U3OutlineMode mode = U3OutlineMode.off,
+}) {
+  final doc = SceneDocument(allocator: IdAllocator(session: 0x75337072));
+  final material = doc.addResource(
+    MaterialResource(
+      doc.newId(),
+      type: 'unlit',
+      properties: {'baseColor': const ColorValue(0.36, 0.46, 0.62, 1)},
+    ),
+  );
+  GeometryResource triangle(List<Vector3> positions) {
+    final vertices = doc.addPayload(
+      PayloadSpec(
+        doc.newId(),
+        encoding: PayloadEncoding.vertexBuffer,
+        layout: 'unskinned_uv1_tangent',
+        bytes: VertexPack.unskinned(
+          positions: positions,
+          normals: List.generate(3, (_) => Vector3(0, 0, -1)),
+          uvs: [Vector2(0, 0), Vector2(1, 0), Vector2(0, 1)],
+          colors: List.generate(3, (_) => Vector4.all(1)),
+          tangents: List.generate(3, (_) => Vector4(1, 0, 0, -1)),
+        ),
+      ),
+    );
+    final indexData = ByteData(6)
+      ..setUint16(0, 0, Endian.little)
+      ..setUint16(2, 2, Endian.little)
+      ..setUint16(4, 1, Endian.little);
+    final indices = doc.addPayload(
+      PayloadSpec(
+        doc.newId(),
+        encoding: PayloadEncoding.indexBuffer,
+        format: 'uint16',
+        bytes: indexData.buffer.asUint8List(),
+      ),
+    );
+    return doc.addResource(
+      GeometryResource(doc.newId(), vertices: vertices.id, indices: indices.id),
+    );
+  }
+
+  final lower = triangle([
+    Vector3(-0.65, -0.5, 0),
+    Vector3(0.6, -0.5, 0),
+    Vector3(-0.65, 0.7, 0),
+  ]);
+  final wing = triangle([
+    Vector3(-0.65, 0.7, 0),
+    Vector3(0.6, -0.5, 0),
+    Vector3(0.95, 0.2, 0.55),
+  ]);
+  doc.addNode(
+    NodeSpec(
+      id: u3OutlineMesh,
+      name: 'outline.asymmetric',
+      transform: TrsTransform(translation: Vector3(-0.85, 0.2, 0)),
+      components: [
+        ComponentSpec(
+          'mesh',
+          properties: {
+            'primitives': ListValue([
+              for (final geometry in [lower, wing])
+                MapValue({
+                  'geometry': ResourceRefValue(geometry.id),
+                  'material': ResourceRefValue(material.id),
+                }),
+            ]),
+          },
+        ),
+      ],
+      children: [u3OutlineChild],
+    ),
+  );
+  doc.roots.add(u3OutlineMesh);
+  doc.addNode(
+    NodeSpec(
+      id: u3OutlineChild,
+      name: 'outline.authored-child-unselected',
+      transform: TrsTransform(translation: Vector3(0, 1.1, 0)),
+      components: [
+        d3ProcMeshComponent(
+          D3CuboidProc(extents: Vector3(0.3, 0.3, 0.3)),
+          material: material.id,
+        ),
+      ],
+    ),
+  );
+  doc.addNode(
+    NodeSpec(
+      id: u3OutlineBatch,
+      name: 'outline.native-batch',
+      layers: 2,
+      transform: TrsTransform(translation: Vector3(0.9, -0.4, 0.3)),
+      components: [
+        D3InstancesSpec(
+          proc: D3WedgeProc(size: Vector3(0.5, 0.7, 0.45)),
+          material: material.id,
+          transforms: D3InstanceTransforms.inline([
+            Matrix4.identity()..setTranslationRaw(-0.4, 0, 0),
+            Matrix4.identity()..setTranslationRaw(0.45, 0.3, 0.5),
+            Matrix4.identity()..setTranslationRaw(0, -0.6, -0.4),
+          ]),
+        ).toComponent(),
+      ],
+    ),
+  );
+  doc.roots.add(u3OutlineBatch);
+  doc.addNode(
+    NodeSpec(
+      id: u3OutlineControl,
+      name: u3OutlineMarker,
+      transform: TrsTransform(
+        translation: Vector3(mode.index.toDouble(), 0, 0),
+      ),
+    ),
+  );
+  doc.roots.add(u3OutlineControl);
+  for (final (id, position) in [
+    (u3OutlineCameraA, Vector3(0, 0.2, -6)),
+    (u3OutlineCameraB, Vector3(4.2, 2.4, -4.2)),
+    (u3OutlineCameraTarget, Vector3(-3, 1.2, -5)),
+  ]) {
+    doc.addNode(
+      NodeSpec(
+        id: id,
+        name: 'outline.camera.${id.index}',
+        transform: TrsTransform(
+          translation: position,
+          rotation: aimAlong(Vector3(0, 0.2, 0) - position),
+        ),
+        components: [
+          ComponentSpec(
+            'camera',
+            properties: {
+              'projection': const StringValue('orthographic'),
+              'orthoScale': const DoubleValue(3.8),
+              'near': const DoubleValue(0.1),
+              'far': const DoubleValue(30),
+            },
+          ),
+        ],
+      ),
+    );
+    doc.roots.add(id);
+  }
+  final target = doc.addResource(
+    RenderTextureResource(doc.newId(), width: 96, height: 72, update: 'manual'),
+  );
+  doc.views.addAll([
+    RenderViewSpec(
+      cameraNode: u3OutlineCameraTarget,
+      target: target.id,
+      layerMask: 3,
+      antiAliasingMode: targetMsaa ? 'msaa' : 'none',
+    ),
+    Dart3dRenderViewSpec(
+      cameraNode: u3OutlineCameraA,
+      layerMask: 3,
+      antiAliasingMode: 'none',
+      renderScale: 1,
+      viewport: single ? null : [0, 0, 570, 570],
+    ),
+    if (!single)
+      Dart3dRenderViewSpec(
+        cameraNode: u3OutlineCameraB,
+        layerMask: 1,
+        antiAliasingMode: 'none',
+        renderScale: 1,
+        order: 1,
+        viewport: [590, 140, 380, 430],
+      ),
+  ]);
+  PayloadSpec floats(List<double> values) {
+    final data = ByteData(values.length * 4);
+    for (var i = 0; i < values.length; i++) {
+      data.setFloat32(i * 4, values[i], Endian.little);
+    }
+    return doc.addPayload(
+      PayloadSpec(
+        doc.newId(),
+        encoding: PayloadEncoding.floats,
+        bytes: data.buffer.asUint8List(),
+      ),
+    );
+  }
+
+  final times = floats([0, 1.5, 3]);
+  final positions = floats([-0.85, 0.2, 0, -0.35, 0.7, 0.3, -0.85, 0.2, 0]);
+  doc.addAnimation(
+    AnimationSpec(
+      doc.newId(),
+      name: 'outline.native-motion',
+      channels: [
+        AnimationChannelSpec(
+          target: u3OutlineMesh,
+          property: AnimationProperty.translation,
+          timeline: times.id,
+          keyframes: positions.id,
+        ),
+      ],
+    ),
+  );
+  doc.stage.environmentRef = doc
+      .addResource(
+        EnvironmentResource(
+          doc.newId(),
+          environment: const EmptyEnvironment(),
+          environmentIntensity: 0,
+          exposure: 1,
+          toneMapping: 'linear',
+          effects: EnvironmentEffectsSpec(),
+        ),
+      )
+      .id;
+  return doc;
+}
+
+void setU3OutlineColors(SceneController controller) =>
+    controller.setNodeHighlights({
+      u3OutlineMesh: Vector4(1, 0.25, 0.0625, 0),
+      u3OutlineBatch: Vector4(0.0625, 0.5, 1, 0.5),
+    });
+
+void clearU3OutlineColors(SceneController controller) =>
+    controller.setNodeHighlights({u3OutlineMesh: null, u3OutlineBatch: null});
+
+void setU3OutlineMode(
+  SceneController controller,
+  U3OutlineMode mode, {
+  required bool cameraB,
+}) => controller.setNodeTransforms([
+  NodeTransform(
+    u3OutlineControl,
+    translation: Vector3(mode.index.toDouble(), cameraB ? 1 : 0, 0),
+  ),
+]);
+
+void setU3OutlineCameraPose(
+  SceneController controller, {
+  required bool alternate,
+  bool single = false,
+}) {
+  final position = alternate
+      ? Vector3(2.2, 1.7, -5.2)
+      : single
+      ? Vector3(0, 0.2, -6)
+      : Vector3(4.2, 2.4, -4.2);
+  controller.setNodeTransforms([
+    NodeTransform(
+      single ? u3OutlineCameraA : u3OutlineCameraB,
+      translation: position,
+      rotation: aimAlong(Vector3(0, 0.2, 0) - position),
+    ),
+  ]);
+}
diff --git a/dart3d/example/test/u3_outline_views_test.dart b/dart3d/example/test/u3_outline_views_test.dart
new file mode 100644
--- /dev/null
+++ b/dart3d/example/test/u3_outline_views_test.dart
@@ -0,0 +1,296 @@
+// ignore_for_file: implementation_imports
+
+import 'dart:convert';
+import 'dart:typed_data';
+
+import 'package:dart3d/dart3d.dart';
+import 'package:dart3d/src/protocol.dart';
+import 'package:dart3d/src/scene_view.dart';
+import 'package:dart3d_example/u3_outline_views_scene.dart';
+import 'package:test/test.dart';
+
+class _Sink extends SceneViewElement {
+  _Sink(SceneController controller)
+    : super(SceneViewLeaf(controller: controller));
+  final mutations = <({int tag, Uint8List data})>[];
+  @override
+  int? get viewId => null;
+  @override
+  void sendMutation(int tag, Uint8List data) =>
+      mutations.add((tag: tag, data: data));
+  List<dynamic> get commands => [
+    for (final mutation in mutations)
+      if (mutation.tag == D3Protocol.command)
+        jsonDecode(utf8.decode(mutation.data)),
+  ];
+}
+
+void main() {
+  test(
+    'real public color batches and separate null clears never request a target render',
+    () {
+      final controller = SceneController()
+        ..loadDocument(buildU3OutlineViewsDocument());
+      addTearDown(controller.dispose);
+      final sink = _Sink(controller);
+      controller.attachElement(sink);
+      sink.mutations.clear();
+      setU3OutlineColors(controller);
+      clearU3OutlineColors(controller);
+      expect(sink.mutations.map((m) => m.tag), [
+        D3Protocol.command,
+        D3Protocol.command,
+      ]);
+      expect(sink.commands, [
+        {
+          'op': 'setNodeHighlights',
+          'updates': [
+            {
+              'node': u3OutlineMesh.toToken(),
+              'color': [1.0, 0.25, 0.0625, 0.0],
+            },
+            {
+              'node': u3OutlineBatch.toToken(),
+              'color': [0.0625, 0.5, 1.0, 0.5],
+            },
+          ],
+        },
+        {
+          'op': 'setNodeHighlights',
+          'updates': [
+            {'node': u3OutlineMesh.toToken(), 'color': null},
+            {'node': u3OutlineBatch.toToken(), 'color': null},
+          ],
+        },
+      ]);
+      final target = controller.document!.resources.values
+          .whereType<RenderTextureResource>()
+          .single;
+      controller.renderTexture(target.id);
+      expect(sink.commands.last, {
+        'op': 'render',
+        'target': 'rt:${target.id.toToken()}',
+      });
+      expect(controller.serializeScene()!.nodes[u3OutlineMesh]!.children, [
+        u3OutlineChild,
+      ]);
+    },
+  );
+
+  test(
+    'fixture modes and camera toggle use real transforms; view rebind sends no render',
+    () {
+      final doc = buildU3OutlineViewsDocument();
+      final controller = SceneController()..loadDocument(doc);
+      addTearDown(controller.dispose);
+      final sink = _Sink(controller);
+      controller.attachElement(sink);
+      sink.mutations.clear();
+      setU3OutlineMode(controller, U3OutlineMode.control, cameraB: true);
+      setU3OutlineCameraPose(controller, alternate: true);
+      expect(sink.mutations.map((m) => m.tag), [
+        D3Protocol.setTransforms,
+        D3Protocol.setTransforms,
+      ]);
+      final marker = ByteData.sublistView(sink.mutations.first.data);
+      expect(marker.getUint32(0, Endian.little), 1);
+      expect(marker.getUint32(4, Endian.little), u3OutlineControl.session);
+      expect(marker.getUint32(8, Endian.little), u3OutlineControl.index);
+      expect(marker.getUint8(12), 1);
+      expect(
+        [
+          for (var i = 0; i < 3; i++)
+            marker.getFloat32(13 + i * 4, Endian.little),
+        ],
+        [1, 1, 0],
+      );
+      final before = controller.serializeScene()!;
+      expect(
+        (before.nodes[u3OutlineCameraB]!.transform as TrsTransform)
+            .translation
+            .x,
+        closeTo(2.2, 0.00001),
+      );
+      expect(
+        (before.nodes[u3OutlineCameraA]!.transform as TrsTransform)
+            .translation
+            .x,
+        0,
+      );
+      setU3OutlineCameraPose(controller, alternate: true, single: true);
+      expect(
+        (controller.serializeScene()!.nodes[u3OutlineCameraA]!.transform
+                as TrsTransform)
+            .translation
+            .x,
+        closeTo(2.2, 0.00001),
+      );
+      controller.updateViews(doc.views);
+      expect(sink.commands.single['op'], 'updateViews');
+      expect(sink.commands.single['views'], hasLength(3));
+      expect(
+        controller.serializeScene()!.resources.keys,
+        before.resources.keys,
+      );
+      expect(
+        controller
+            .serializeScene()!
+            .views
+            .singleWhere((v) => v.target != null)
+            .target,
+        before.views.singleWhere((v) => v.target != null).target,
+      );
+    },
+  );
+
+  for (final single in [false, true]) {
+    for (final msaa in [false, true]) {
+      test(
+        'serialized ${single ? "host" : "split"} fixture retains cameras/layers/manual target AA=$msaa',
+        () {
+          final doc = buildU3OutlineViewsDocument(
+            single: single,
+            targetMsaa: msaa,
+          );
+          final controller = SceneController()..loadDocument(doc);
+          addTearDown(controller.dispose);
+          final sink = _Sink(controller);
+          controller.attachElement(sink);
+          final wire =
+              jsonDecode(
+                    utf8.decode(
+                      sink.mutations
+                          .firstWhere((m) => m.tag == D3Protocol.loadScene)
+                          .data,
+                    ),
+                  )
+                  as Map;
+          final restored = readFsceneWithExtensions(
+            writeFsceneWithExtensions(controller.serializeScene()!),
+          );
+          final target = restored.resources.values
+              .whereType<RenderTextureResource>()
+              .single;
+          expect(
+            [target.width, target.height, target.update],
+            [96, 72, 'manual'],
+          );
+          final targetView = restored.views.singleWhere(
+            (v) => v.target != null,
+          );
+          expect(
+            [
+              targetView.cameraNode,
+              targetView.layerMask,
+              targetView.antiAliasingMode,
+            ],
+            [u3OutlineCameraTarget, 3, msaa ? 'msaa' : 'none'],
+          );
+          final screens = restored.views
+              .where((v) => v.target == null)
+              .toList();
+          expect(screens, hasLength(single ? 1 : 2));
+          expect(screens.first.cameraNode, u3OutlineCameraA);
+          expect(
+            (screens.first as Dart3dRenderViewSpec).viewport,
+            single ? isNull : [0.0, 0.0, 570.0, 570.0],
+          );
+          if (!single) {
+            expect(
+              [screens[1].cameraNode, screens[1].layerMask],
+              [u3OutlineCameraB, 1],
+            );
+            expect((screens[1] as Dart3dRenderViewSpec).viewport, [
+              590.0,
+              140.0,
+              380.0,
+              430.0,
+            ]);
+          }
+          expect(wire['views'], hasLength(single ? 2 : 3));
+          final mesh = restored.nodes[u3OutlineMesh]!;
+          final primitives =
+              (mesh.components.single.properties['primitives']! as ListValue)
+                  .values;
+          expect(primitives, hasLength(2));
+          for (final primitive in primitives.cast<MapValue>()) {
+            final id = (primitive.values['geometry']! as ResourceRefValue).id;
+            final geometry = restored.resources[id]! as GeometryResource;
+            final vertices = controller
+                .serializeScene()!
+                .payloads[geometry.vertices]!
+                .bytes!;
+            final indices = controller
+                .serializeScene()!
+                .payloads[geometry.indices]!
+                .bytes!;
+            expect(vertices.length, VertexPack.unskinnedUv1TangentStride * 3);
+            expect(indices, [0, 0, 2, 0, 1, 0]);
+          }
+          expect(mesh.children, [u3OutlineChild]);
+          expect(
+            restored.nodes[u3OutlineChild]!.components.single.type,
+            'd3:procMesh',
+          );
+          final batch = restored.nodes[u3OutlineBatch]!;
+          expect(batch.layers, 2);
+          expect(batch.components.single.type, 'd3:instances');
+          expect(
+            (batch.components.single.properties['transforms']! as ListValue)
+                .values,
+            hasLength(3),
+          );
+        },
+      );
+    }
+  }
+
+  test(
+    'public native animation carries changing asymmetric mesh pose and play/pause commands',
